# dependencies
node_modules/
.pnp.*
.npm/

# builds
dist/
build/
out/
apps/api/dist/
apps/web/dist/
src-tauri/target/
src-tauri/gen/
src-tauri/api/
# ابزارهای کاپی‌شده برای بسته‌بندی (desktop:build خودش می‌سازد)
src-tauri/tools/

# local data (never commit the company database or backups)
data/
*.db
*.db-shm
*.db-wal
backups/

# env & editor
.env
.env.local
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# Tauri resources: generated by `npm run package:api`, never committed
src-tauri/binaries/*
!src-tauri/binaries/README.txt
scripts/ui-check/.out*/

# ZIP نود برای ساخت آفلاین (بزرگ است، نباید در گیت برود)
.cache/

# کلیدهای لایسنس — کلید خصوصی هرگز نباید در گیت برود
license-keys/
!license-keys/.gitkeep
*.lic
# خروجی تست‌های DOM
scripts/ui-check/.out-*
scripts/ui-check/.mock

# کلید «صفر کردن سیستم» — مثل کلید خصوصی لایسنس، هرگز در مخزن نباشد.
# نبودنش برنامه را نمی‌شکند؛ فقط ابزار tools/reset-ui روی نسخه‌ی مُهرشده
# کار نمی‌کند و پیام روشن می‌دهد.
src-tauri/seal/reset-key.txt
reset-key.txt
