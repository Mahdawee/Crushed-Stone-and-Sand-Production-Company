    "seed": "npm run db:seed -w @farday/api --",
    "seed:demo": "npm run build -w @farday/api && npm run db:seed:demo -w @farday/api --",
    "start:api": "npm run start -w @farday/api",
    "tauri": "tauri",
    "build:desktop": "npm run build -w @farday/api && npm run build -w @farday/web",
