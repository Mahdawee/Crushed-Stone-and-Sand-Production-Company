{
  "name": "farday-roshan-sand",
  "private": true,
  "version": "0.1.0",
  "description": "سیستم مدیریت شرکت تولیدی فردای روشن (سنگ، کرش، جغل و ریگ) — آفلاین و محلی",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @farday/api",
    "dev:web": "npm run dev -w @farday/web",
    "build": "npm run build -w @farday/api && npm run build -w @farday/web",
    "start": "node apps/api/dist/main.js",
    "typecheck": "npm run typecheck -w @farday/web && npx tsc -p apps/api/tsconfig.json --noEmit",
    "db:generate": "npm run db:generate -w @farday/api",
    "seed": "npm run db:seed -w @farday/api --",
    "seed:demo": "npm run build -w @farday/api && npm run db:seed:demo -w @farday/api --",
    "start:api": "npm run start -w @farday/api",
    "tauri": "tauri",
    "build:desktop": "npm run build -w @farday/api && npm run build -w @farday/web",
    "package:api": "node scripts/build-desktop-api.mjs --require-node",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:prefetch": "node scripts/build-desktop.mjs --prefetch",
    "desktop:build:cargo-offline": "node scripts/build-desktop.mjs --offline",
    "desktop:build:offline": "node scripts/prepare-offline-desktop.mjs",
    "test:api": "npm run test -w @farday/api",
    "desktop:setup": "npm i -D @tauri-apps/cli@2",
    "doctor": "node scripts/doctor.mjs",
    "find:msvc": "node scripts/find-msvc.mjs",
    "desktop:env": "node scripts/show-msvc-env.mjs",
    "find:builder": "node scripts/find-msvc.mjs",
    "setup": "node scripts/setup.mjs",
    "test:ui": "node scripts/ui-check/layout.test.mjs && node scripts/ui-check/dom.test.mjs && node scripts/ui-check/sidebar.test.mjs && node scripts/ui-check/theme.test.mjs && node scripts/ui-check/form.test.mjs",
    "test:nsis": "node scripts/ui-check/nsis-langs.test.mjs",
    "test:build": "node scripts/ui-check/build-scripts.test.mjs",
    "test:api:smoke": "node apps/api/test/smoke.test.js",
    "test:softdelete": "npm run build -w @farday/api && node apps/api/test/softdelete.test.js",
    "test:scenario": "npm run build -w @farday/api && node apps/api/test/scenario.test.js",
    "test:tauri": "node scripts/ui-check/tauri-src.test.mjs && node scripts/ui-check/rust-syntax.test.mjs",
    "test": "npm run typecheck && npm run test:ui && node scripts/ui-check/routes.test.mjs && npm run test:guards && npm run test:license:guard && npm run test:license && npm run test:round16 && npm run test:round17 && npm run test:softdelete && npm run test:license-nav && npm run test:concepts && npm run test:renew && npm run test:nsis && npm run test:build && npm run test:tauri && npm run test:webview2 && npm run test:ux && npm run test:api && npm run test:scenario && npm run test:packaged",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:form": "node scripts/ui-check/form.test.mjs",
    "test:routes": "node scripts/ui-check/routes.test.mjs",
    "test:guards": "node scripts/ui-check/api-guards.test.mjs",
    "license": "node scripts/license-tool.mjs",
    "license:keygen": "node scripts/license-tool.mjs keygen",
    "license:issue": "node scripts/license-tool.mjs issue",
    "license:verify": "node scripts/license-tool.mjs verify",
    "license:list": "node scripts/license-tool.mjs list",
    "license:revoke": "node scripts/license-tool.mjs revoke",
    "license:export-pub": "node scripts/license-tool.mjs export-pub",
    "test:license": "npm run build -w @farday/api && node apps/api/test/license.test.js",
    "test:round16": "npm run build -w @farday/api && node apps/api/test/round16.test.js",
    "test:round17": "npm run build -w @farday/api && node apps/api/test/round17.test.js",
    "test:license-nav": "node scripts/ui-check/license-nav.test.mjs",
    "test:concepts": "node scripts/ui-check/concepts.test.mjs",
    "test:renew": "node scripts/ui-check/license-renew.test.mjs",
    "test:license:guard": "node scripts/ui-check/license-guard.test.mjs",
    "license:ui": "node tools/license/server.mjs",
    "webview2:prepare": "node scripts/lib/webview2.mjs",
    "webview2:status": "node scripts/lib/webview2.mjs --status",
    "test:webview2": "node scripts/ui-check/webview2-offline.test.mjs",
    "test:ux": "node scripts/ui-check/ux-behaviour.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "jsdom": "^27.0.0"
  }
}
