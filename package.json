    "test:auth": "npm run build -w @farday/api && node apps/api/test/auth.test.js",
    "test:recovery": "npm run build -w @farday/api && node apps/api/test/recovery.test.js",
    "test:upgrade": "npm run build -w @farday/api && node apps/api/test/upgrade.test.js",
    "test:first-run": "npm run build -w @farday/api && node apps/api/test/first-run.test.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
