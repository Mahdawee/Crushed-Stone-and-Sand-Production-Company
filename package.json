    "test:rollback-retry": "node scripts/ui-check/rollback-retry.test.mjs",
    "check:cmd": "node scripts/check-cmd-crlf.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "test": "node scripts/preflight.mjs && npm run test:syntax && npm run typecheck && npm run test:ui && node scripts/ui-check/routes.test.mjs && npm run test:guards && npm run test:license:guard && npm run test:date-input && npm run test:license-dates && npm run test:license && npm run test:round16 && npm run test:round17 && npm run test:softdelete && npm run test:walkin && npm run test:reset && npm run test:reset-tool && npm run test:tool-runners && npm run test:auth && npm run test:recovery && npm run test:operator && npm run test:print && npm run test:debts && npm run test:backup-folder && npm run test:audit-41 && npm run test:verify-msi && npm run test:bundle-deps && npm run test:win-imports && npm run test:rollback-retry && npm run check:cmd && npm run test:upgrade && npm run test:first-run && npm run test:recovery && npm run test:tracking && npm run test:license-nav && npm run test:concepts && npm run test:renew && npm run test:paths && npm run test:print && npm run test:nsis && npm run test:build && npm run test:tauri && npm run test:webview2 && npm run test:ux && npm run test:pages && npm run test:api && npm run test:partial && npm run test:put-merge && npm run test:report-integrity && npm run test:bundle && npm run test:indexes && npm run test:search && npm run test:backup && npm run test:bugs && npm run test:first-run && npm run test:reset-cli && npm run test:scenario && npm run test:packaged",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:form": "node scripts/ui-check/form.test.mjs",
    "test:routes": "node scripts/ui-check/routes.test.mjs",
    "test:guards": "node scripts/ui-check/api-guards.test.mjs",
    "license": "node scripts/license-tool.mjs",
    "license:keygen": "node scripts/license-tool.mjs keygen",
    "license:issue": "node scripts/license-tool.mjs issue",
    "license:verify": "node scripts/license-tool.mjs verify",
    "license:list": "node scripts/license-tool.mjs list",
    "license:revoke": "node scripts/license-tool.mjs revoke",
    "license:export-pub": "node scripts/license-tool.mjs export-pub",
    "test:license": "npm run build -w @farday/api && node apps/api/test/license.test.js",
    "test:round16": "npm run build -w @farday/api && node apps/api/test/round16.test.js",
    "test:round17": "npm run build -w @farday/api && node apps/api/test/round17.test.js",
    "test:license-nav": "node scripts/ui-check/license-nav.test.mjs",
    "test:concepts": "node scripts/ui-check/concepts.test.mjs",
    "test:renew": "node scripts/ui-check/license-renew.test.mjs",
    "test:license:guard": "node scripts/ui-check/license-guard.test.mjs",
    "test:date-input": "node scripts/ui-check/date-input.test.mjs",
    "test:license-dates": "node scripts/ui-check/license-dates.test.mjs",
    "license:ui": "node tools/license/server.mjs",
    "reset:ui": "node tools/reset-ui/server.mjs",
    "reset:key": "node scripts/reset-key.mjs",
    "reset": "node tools/reset-ui/cli.mjs",
    "webview2:prepare": "node scripts/lib/webview2.mjs",
    "webview2:status": "node scripts/lib/webview2.mjs --status",
    "test:webview2": "node scripts/ui-check/webview2-offline.test.mjs",
