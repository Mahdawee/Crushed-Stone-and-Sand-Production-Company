{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farday Roshan",
  "version": "0.1.0",
  "identifier": "af.farday.roshan",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "http://127.0.0.1:4317"
  },
  "app": {
    "windows": [
      {
        "title": "فردای روشن — مدیریت شرکت تولیدی",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:4317 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "binaries/*",
      "api/**"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Persian",
          "English"
        ]
      }
    },
    "shortDescription": "مدیریت فروشات، مصارف، معاشات و راپورهای شرکت",
    "longDescription": "سیستم محلی مدیریت شرکت تولیدی فردای روشن — کاملاً آفلاین، بدون نیاز به انترنت"
  }
}