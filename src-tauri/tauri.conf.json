{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farday Roshan",
  "version": "0.1.0",
  "identifier": "af.farday.roshan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:4317 http://localhost:5173 ws://localhost:5173 ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "api/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Farsi",
          "English"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Farsi": "nsis/Farsi.nsh"
        }
      }
    },
    "shortDescription": "مدیریت فروشات، مصارف، معاشات و راپورهای شرکت",
    "longDescription": "سیستم مدیریت شرکت تولیدی فردای روشن — کاملاً آفلاین، بدون نیاز به انترنت"
  }
}
